<string>src="gallery.swift"
bin="bin/screenshot-gallery"

# Build on first use (and whenever the source changes)
if [ ! -x "$bin" ] || [ "$src" -nt "$bin" ]; then
  mkdir -p bin
  if ! /usr/bin/swiftc -O -swift-version 5 -o "$bin" "$src" 2&gt;/tmp/screenshot-gallery-build.log; then
    /usr/bin/osascript -e 'display notification "Build failed, see /tmp/screenshot-gallery-build.log" with title "Screenshot Gallery"'
    exit 1
  fi
fi

# Replace an already-open gallery so it always shows the latest screenshots
/usr/bin/pkill -x screenshot-gallery 2&gt;/dev/null
nohup "./$bin" "$HOME/Documents/screenshots" &gt;/dev/null 2&gt;&amp;1 &amp;</string>
